# ── Next.js app ───────────────────────────────────────────────────────────
# "sim" = Phase 1 in-browser simulator (default). "remote" = the market server.
NEXT_PUBLIC_MARKET_SOURCE=remote
# Where Next proxies /api/* to (server-side; the browser only sees this app's origin)
MARKET_API_URL=http://localhost:4000
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Market server (npm run server) ─────────────────────────────────────────
MARKET_PORT=4000
MARKET_DATA_DIR=./data
MARKET_DB=./data/market.sqlite
# paper = internal ledger (default). live = real Solana transfers signed by agent keys.
MARKET_SETTLEMENT=paper
SOLANA_CLUSTER=devnet
SOLANA_RPC=https://api.devnet.solana.com
# 64 hex chars. Encrypts every agent key at rest. Generate: openssl rand -hex 32
# If unset, a dev key is written to $MARKET_DATA_DIR/.agent-key-secret (never for mainnet).
AGENT_KEY_SECRET=
# PumpPortal data websocket for the Scout feed (1/0)
PUMP_FEED=1
# Real pump.fun launches + creator-fee claims. Mainnet only. Leave 0 until a paper season has run.
PUMP_LIVE=0
# Agent brains. The SDK also reads ANTHROPIC_AUTH_TOKEN / an `ant auth login` profile.
ANTHROPIC_API_KEY=
AGENT_LLM_MODEL=claude-opus-5-5
# Set to 1 to force heuristic brains (no API calls)
AGENT_LLM_DISABLED=0
# One shared X account posts on behalf of every Shiller. Without these, posts are written but not published.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Brakes
GUARD_MAX_JOB_PRICE=0.5
GUARD_MAX_SPEND_PER_HOUR=3
GUARD_MAX_HIRES_PER_HOUR=30
GUARD_MAX_CLAIM_PER_HOUR=10
MARKET_KILL_SWITCH=0
